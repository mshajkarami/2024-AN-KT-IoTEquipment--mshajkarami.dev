<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background">

    <LinearLayout
        android:id="@+id/settingsRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical">

        <include
            android:id="@+id/include_profile"
            layout="@layout/item_profile" />

        <include
            android:id="@+id/item_account"
            layout="@layout/item_account" />

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <include
            android:id="@+id/include_preferences"
            layout="@layout/item_preferences"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <include
            android:id="@+id/include_help"
            layout="@layout/item_help"
            />

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <include
            android:id="@+id/include_log_settings"
            layout="@layout/item_log_settings"
            />
    </LinearLayout>
</ScrollView>
