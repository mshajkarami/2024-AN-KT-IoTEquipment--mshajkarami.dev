<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="6dp"
        app:cardElevation="2dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@color/md_theme_surfaceVariant">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchBox"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:hint="@string/search_hint"
                android:textColorHint="@color/black"
                app:boxBackgroundColor="@color/md_theme_surfaceVariant"
                app:boxBackgroundMode="filled"
                app:boxStrokeColor="@color/md_theme_outline"
                app:boxStrokeWidth="0.5dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:counterMaxLength="20"
                app:endIconMode="clear_text"
                app:endIconTint="@color/md_theme_onSurfaceVariant"
                app:hintTextColor="@color/md_theme_onSurfaceVariant"
                app:layout_constraintEnd_toStartOf="@+id/btn_scanBarcode"
                app:layout_constraintStart_toStartOf="parent"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/md_theme_onSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLength="30"
                    android:maxLines="1"
                    android:textColor="@color/md_theme_onSurface"
                    android:textSize="15sp" />


            </com.google.android.material.textfield.TextInputLayout>

            <ImageButton
                android:id="@+id/btn_scanBarcode"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/qr_btn_scan"
                android:src="@drawable/ic_scanner"
                android:scaleType="centerInside"
                android:background="@null"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/black" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>



</merge>
