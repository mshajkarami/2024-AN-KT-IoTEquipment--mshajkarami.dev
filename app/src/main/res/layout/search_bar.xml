<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        app:endIconMode="clear_text"
        app:counterMaxLength="20"
        app:boxStrokeWidth = "0.3dp"
        app:boxStrokeColor="@color/md_theme_background"
        app:boxStrokeWidthFocused = "1.5dp"
        app:boxBackgroundMode="filled"
        app:startIconDrawable="@drawable/ic_search"
        app:boxBackgroundColor="@color/md_theme_inversePrimary_mediumContrast"
        android:hint="@string/searchbar_hint"
        app:boxCornerRadiusTopStart="15dp"
        app:boxCornerRadiusTopEnd="15dp"
        app:boxCornerRadiusBottomStart="15dp"
        app:boxCornerRadiusBottomEnd="15dp"
        android:textAppearance="@color/md_theme_background"
        app:placeholderTextAppearance="@color/md_theme_background"
        >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="30"
            android:maxLines="1"
            />

    </com.google.android.material.textfield.TextInputLayout>

</merge>
