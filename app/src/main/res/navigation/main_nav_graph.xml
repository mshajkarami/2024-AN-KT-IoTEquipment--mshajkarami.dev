<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.irisaco.iotequipment.ui.home.HomeFragment"
        tools:layout="@layout/fragment_home"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.irisaco.iotequipment.ui.search.SearchFragment"
        tools:layout="@layout/fragment_search"
        android:label="SearchFragment" >
        <action
            android:id="@+id/action_searchFragment_to_equipmentDetailFragment"
            app:destination="@id/equipmentDetailFragment" />
        <action
            android:id="@+id/action_searchFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/equipmentDetailFragment"
        android:name="com.irisaco.iotequipment.ui.detail.EquipmentDetailFragment"
        android:label="fragment_equipment_detail"
        tools:layout="@layout/fragment_equipment_detail">

        <argument
            android:name="equipmentId"
            app:argType="integer" />
        <action
            android:id="@+id/action_equipmentDetailFragment_to_attachmentsFragment"
            app:destination="@id/attachmentsFragment" />
        <action
            android:id="@+id/action_equipmentDetailFragment_to_searchFragment"
            app:destination="@id/searchFragment" />

    </fragment>
    <fragment
        android:id="@+id/attachmentsFragment"
        android:name="com.irisaco.iotequipment.ui.AttachmentsFragment"
        android:label="fragment_attachments"
        tools:layout="@layout/fragment_attachments" >
        <argument
            android:name="equipmentId"
            app:argType="integer" />
        <action
            android:id="@+id/action_attachmentsFragment_to_equipmentDetailFragment"
            app:destination="@id/equipmentDetailFragment" />
    </fragment>


</navigation>