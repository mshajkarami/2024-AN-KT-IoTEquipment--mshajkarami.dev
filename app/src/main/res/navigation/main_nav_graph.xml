<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/homeFragment"
    >

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.irisaco.iotequipment.ui.home.HomeFragment"
        tools:layout="@layout/fragment_home"
        android:label="HomeFragment" >
        <action
            android:id="@+id/action_homeFragment_to_searchFragment"
            app:destination="@id/searchFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="equipmentIdUnique"
                app:argType="string" />
        </action>

    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.irisaco.iotequipment.ui.search.SearchFragment"
        tools:layout="@layout/fragment_search"
        android:label="SearchFragment" >
        <argument
            android:name="equipmentIdUnique"
            app:argType="string"
            android:defaultValue="" />

        <action
            android:id="@+id/action_searchFragment_to_equipmentDetailFragment"
            app:destination="@id/equipmentDetailFragment" />
        <action
            android:id="@+id/action_searchFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/equipmentDetailFragment"
        android:name="com.irisaco.iotequipment.ui.detail.DetailFragment"
        android:label="fragment_equipment_detail"
        tools:layout="@layout/fragment_detail">

        <argument
            android:name="equipmentId"
            app:argType="integer" />

        <action
            android:id="@+id/action_global_attachmentsFragment"
            app:launchSingleTop="true"
            app:destination="@id/attachmentsFragment" />

        <action
            android:id="@+id/action_equipmentDetailFragment_to_searchFragment"
            app:destination="@id/searchFragment" />
        <action
            android:id="@+id/action_equipmentDetailFragment_to_logDetailFragment"
            app:destination="@id/logDetailFragment" />
        <action
            android:id="@+id/action_equipmentDetailFragment_to_addLogFragment"
            app:destination="@id/addLogFragment" />

    </fragment>

    <fragment
        android:id="@+id/attachmentsFragment"
        android:name="com.irisaco.iotequipment.ui.detail.attachments.AttachmentsFragment"
        android:label="fragment_attachments"
        tools:layout="@layout/fragment_attachments" >

        <argument
            android:name="equipmentId"
            app:argType="integer" />

        <action
            android:id="@+id/action_attachmentsFragment_to_equipmentDetailFragment"
            app:destination="@id/equipmentDetailFragment" />
    </fragment>
    <fragment
        android:id="@+id/logDetailFragment"
        tools:layout="@layout/fragment_detail_log"
        android:name="com.irisaco.iotequipment.ui.detail.log.log_detail.LogDetailFragment"
        android:label="LogDetailFragment" >
        <action
            android:id="@+id/action_logDetailFragment_to_equipmentDetailFragment"
            app:destination="@id/equipmentDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/addLogFragment"
        android:name="com.irisaco.iotequipment.ui.detail.log.log_add.AddLogFragment"
        tools:layout="@layout/fragment_add_log"
        android:label="HomeFragment" >


    </fragment>


</navigation>